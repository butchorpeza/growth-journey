{
  "name": "growth-journey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Growth Journey: an interactive 3D About page for Butch Orpeza, Digital Growth Strategist.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
